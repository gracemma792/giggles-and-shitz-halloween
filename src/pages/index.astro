---
import '../styles/global.css';
import '../styles/overrides.css';
import '../styles/dj.css';
import '../styles/grace.css';
import '../styles/about-three.css';

const bats = Array.from({ length: 18 }, (_, index) => ({
  id: index,
  style: `--i:${index}; --x:${(index * 17) % 96}; --y:${(index * 31) % 84}; --s:${0.45 + ((index * 13) % 8) / 10}; --d:${7 + (index % 6) * 1.3}s; --delay:-${(index * 1.37).toFixed(1)}s`,
}));
---

<html lang="en">
  <head>
	<meta name="robots" content="noindex, nofollow, noarchive" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Halloparty 26 — a GAS production." />
    <link rel="icon" href="./favicon.svg" type="image/svg+xml" />
    <title>Halloparty 26 — GAS</title>
  <style>
    .pizza-section.is-hidden {
      display: none;
    }
  </style>
  </head>
  <body>
  <div class="rsvp-jumpscare" id="rsvp-jumpscare" aria-hidden="true"><div class="rsvp-jumpscare-inner"><div class="rsvp-jumpscare-face"><img src="/giggles-and-shitz-halloween/momo.jpg" alt="" /></div><div class="rsvp-jumpscare-text">HAHA. YOU’RE COMING.</div></div></div>
    <div class="grain"></div>
    <div class="moon" aria-hidden="true"></div>
    <div class="bat-swarm" aria-hidden="true">
      {bats.map((bat) => <span class="bat" style={bat.style}>🦇</span>)}
    </div>

    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label="Giggles and Shitz home">GAS</a>
      <nav aria-label="Main navigation">
        <a href="#details">The plan</a>
        <a href="#costumes">Costumes</a>
        <a href="#about">About GAS</a>
        <a class="nav-rsvp" href="#rsvp">RSVP</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">GAS presents</p>
          <h1>Hallo<em>party<br />26.</em></h1>
          <p class="hero-text">A GAS production: costumes, pizza, drinks and a proper Saturday night in Wareemba. Limited space so RSVP soon!</p>
          <a class="button button-orange" href="#rsvp">RSVP <span>→</span></a>
        </div>
        <div class="poster">
          <div class="poster-stars">✦ &nbsp; ✧ &nbsp; ✦</div>
          <img src="./giggles-shitz-wordmark.svg" alt="Giggles and Shitz" />
          <p>HALLOWEEN · WAREEMBA</p>
          <div class="poster-date"><b>31</b><span>OCT<br />FRI</span></div>
          <div class="poster-splat">COSTUMES<br />ARE<br />COMPULSORY</div>
        </div>
      </section>

      <section id="details" class="event-details wrap section">
        <p class="eyebrow">Mark your haunted calendar</p>
        <div class="details-grid">
          <article><span class="detail-icon">◒</span><h2>When</h2><p><b>Saturday, 31 October</b><br />Starts at 8:00pm</p></article>
          <article><span class="detail-icon">⌂</span><h2>Where</h2><p><b>8 Coranto Street</b><br />Wareemba</p></article>
          <article><span class="detail-icon">✦</span><h2>Guests</h2><p><b>Bring up to two friends</b><br />Add them in your RSVP</p></article>
          <article><span class="detail-icon">◈</span><h2>Drinks</h2><p><b>BYO</b><br />Bring whatever you like to drink</p></article>
        </div>
      </section>

      <section id="costumes" class="costumes section">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">Costumes compulsory</p><h2>Costume <em>notes</em></h2></div><p>Keep it polished, strange or specific. The assignment is open.</p></div>
          <div class="inspo-grid">
            <article class="inspo ghost"><span>01</span><h3>Dead<br />prom queen</h3><p>Pretty, ruined, perfect.</p></article>
            <article class="inspo witch"><span>02</span><h3>Inanimate<br />object</h3><p>Commit to the bit.</p></article>
            <article class="inspo alien"><span>03</span><h3>2025–26<br />controversy</h3><p>Keep it clever.</p></article>
            <article class="inspo clown"><span>04</span><h3>Vampire<br />after dark</h3><p>Black tailoring, one good detail.</p></article>
            <article class="inspo fifth"><span>05</span><h3>Last-minute<br />icon</h3><p>Simple can still be sharp.</p></article>
            <article class="inspo sixth"><span>06</span><h3>Something<br />uncanny</h3><p>Recognisable from across the room.</p></article>
          </div>
        </div>
      </section>

      <section id="dj" class="dj-spotlight section" aria-label="DJ spotlight">
        <div class="light-beam beam-one"></div><div class="light-beam beam-two"></div><div class="light-beam beam-three"></div>
        <div class="wrap dj-grid">
          <div class="dj-copy"><p class="eyebrow">On the decks</p><h2>Shawn<br /><em>Alvyss.</em></h2><p>Keeping Halloparty 26 moving all night.</p><a class="vinyl-button" href="https://www.instagram.com/shawnalvyss/" target="_blank" rel="noopener" aria-label="Follow Shawn Alvyss on Instagram"><span>IG</span></a><small>Tap the record to follow</small></div>
          <figure class="dj-photo"><img src="./shawn-alvyss.png" alt="DJ Shawn Alvyss on the decks" /><figcaption>HALL0PARTY 26 · DJ SET</figcaption></figure>
        </div>
      </section>

      <section id="rsvp" class="rsvp section">
        <div class="wrap rsvp-grid">
          <div><p class="eyebrow">Saturday 31 October</p><h2>RSVP<br /><em>here.</em></h2><p class="rsvp-note">Please reply by <b>24 October</b>.</p><div class="pumpkin">🎃</div></div>
          <form class="rsvp-form form-card" data-form="rsvp" action="https://formsubmit.co/gmarka876@gmail.com" method="POST">
  <input type="hidden" name="_subject" value="🎃 New Halloparty RSVP">
  <input type="hidden" name="_captcha" value="false">
  <input type="hidden" name="_template" value="table">
            <label class="field-label">Name<input required name="name" autocomplete="name" placeholder="Your name" /></label>
            <fieldset class="attendance"><legend>Can you make it?</legend><label><input required type="radio" name="attending" value="Yes" /> Yes</label><label><input type="radio" name="attending" value="No" /> No</label></fieldset>
            <label class="field-label">Friends coming with you?<select name="guests"><option value="0">Just me</option><option value="1">+1 friend</option></select><small>Guest option is subject to numbers.</small></label>
            <button class="button button-orange" type="submit">Send RSVP <span>→</span></button>
            <p class="form-message" aria-live="polite"></p>
          </form>
        </div>
      </section>

      

      <section class="pizza-section wrap section is-hidden" id="pizza">
        <div class="pizza-title"><p class="eyebrow">Important business</p><h2>Pizza <em>order</em></h2><p>Let us know what you want so we can order properly.</p></div>
        <form class="pizza-form form-card" data-form="pizza" action="https://formsubmit.co/gmarka876@gmail.com" method="POST">
  <input type="hidden" name="_subject" value="🍕 New Halloparty Pizza Order">
  <input type="hidden" name="_captcha" value="false">
  <input type="hidden" name="_template" value="table">
          <fieldset>
            <legend>Vote for one pizza</legend>
            <label><input required type="radio" name="pizza" value="Pepperoni" /> <span>🍕</span> Pepperoni</label>
            <label><input type="radio" name="pizza" value="Hawaiian" /> <span>🍍</span> Hawaiian</label>
            <label><input type="radio" name="pizza" value="Supreme" /> <span>🫑</span> Supreme</label>
            <label><input type="radio" name="pizza" value="BBQ Meatlovers" /> <span>🥓</span> BBQ Meatlovers</label>
            <label><input type="radio" name="pizza" value="BBQ Chicken & Bacon" /> <span>🍗</span> BBQ Chicken & Bacon</label>
            <label><input type="radio" name="pizza" value="Vegorama" /> <span>🥬</span> Vegorama</label>
          </fieldset>
          <label class="field-label">Any allergies / dietary things?<input name="dietary" placeholder="e.g. gluten-free, no dairy, no anchovies please..." /></label>
          <button class="button button-lime" type="submit">Submit pizza choice <span>↗</span></button>
          <p class="form-message" aria-live="polite"></p>
        </form>
      </section>

      
      <section id="about" class="about wrap section">
        <p class="eyebrow">The people behind it</p>
        <h2>About <em>GAS.</em></h2>
        <div class="about-grid">
          <div class="polaroids" aria-label="Grace and Manuja">
            <figure class="polaroid grace-card"><div class="grace-photo"><img src="./grace.png" alt="Grace in costume" /></div><figcaption>Grace <b>←</b></figcaption></figure>
            <figure class="polaroid manuja-card"><div class="manuja-photo"><img src="./manuja.png" alt="Manuja in costume" /></div><figcaption><b>→</b> Manuja</figcaption></figure>
            <figure class="polaroid friends-card"><div class="friends-photo"><img src="./gas-friends.jpg" alt="Grace and Manuja together" /></div><figcaption>Grace + Manuja <b>😂💩</b></figcaption></figure>
          </div>
          <div class="about-copy">
            <p>Giggles &amp; Shitz Productions started when Grace and Manuja were bored at UTS and decided to make a podcast. It quickly became an ongoing excuse to make things, dress up and take a good idea much further than necessary.</p>
            <p>Since then, they have stayed committed to the giggles, the shitz and their loyal fan base.
This year: <b>Halloparty 26</b>, their biggest production yet.</p>
            <a class="button button-orange" href="#rsvp">RSVP to Halloparty 26 <span>→</span></a>
            <div class="instagram-links">
              <a class="instagram-button" href="https://www.instagram.com/manuja.99/" target="_blank" rel="noopener">
                📸 Manuja's Instagram
              </a>
              <a class="instagram-button" href="https://www.instagram.com/grace.markakis/" target="_blank" rel="noopener">
                📸 Grace's Instagram
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer><img src="./giggles-shitz-wordmark.svg" alt="Giggles and Shitz" /><p>Halloparty 26 · Wareemba · BYO</p></footer>
    <script>
  const pizzaSection = document.querySelector('#pizza');
  const djSpotlight = document.querySelector('#dj');
  const attendanceInputs = document.querySelectorAll('input[name="attending"]');
  const jumpscare = document.querySelector('#rsvp-jumpscare');

  function updatePizzaVisibility() {
    const yesSelected = document.querySelector(
      'input[name="attending"][value="Yes"]:checked'
    );

    pizzaSection?.classList.toggle('is-hidden', !yesSelected);
  }

  attendanceInputs.forEach((input) => {
    input.addEventListener('change', () => {
      updatePizzaVisibility();

      if (input.value === 'Yes' && input.checked && jumpscare) {
        jumpscare.classList.remove('active');
        void jumpscare.offsetWidth;
        jumpscare.classList.add('active');

        setTimeout(() => {
          pizzaSection?.classList.remove('is-hidden');
        }, 1600);
      }
    });
  });

  if (djSpotlight) {
    new IntersectionObserver(([entry]) => {
      document.body.classList.toggle('dj-active', entry.isIntersecting && entry.intersectionRatio > 0.55);
    }, { threshold: [0.55] }).observe(djSpotlight);
  }

  document.querySelectorAll('form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector('button[type="submit"]');
      const message = form.querySelector('.form-message');
      const originalText = button?.innerHTML;

      if (button) {
        button.disabled = true;
        button.innerHTML = 'Sending...';
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            Accept: 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error('Form submission failed');
        }

        if (form.dataset.form === 'rsvp') {
          if (message) {
            const attending = new FormData(form).get('attending');
            message.innerHTML = attending === 'Yes'
              ? 'You’re on the list. <a class="pizza-nudge" href="#pizza">WAIT! 🍕🍕🍕 Choose your pizza vote →</a>'
              : 'Thanks for letting us know.';
          }
        }

        if (form.dataset.form === 'pizza') {
          if (message) {
            message.textContent = 'Pizza order received 🍕';
          }
        }

        if (button) {
          button.innerHTML = 'Sent ✓';
        }
      } catch (error) {
        if (message) {
          message.textContent = 'Oops, something went wrong. Please try again.';
        }

        if (button) {
          button.disabled = false;
          button.innerHTML = originalText;
        }
      }
    });
  });
</script>
  </body>
</html>
