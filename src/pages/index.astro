---
import '../styles/global.css';
import '../styles/overrides.css';

const bats = Array.from({ length: 18 }, (_, index) => ({
  id: index,
  style: `--i:${index}; --x:${(index * 17) % 96}; --y:${(index * 31) % 84}; --s:${0.45 + ((index * 13) % 8) / 10}; --d:${7 + (index % 6) * 1.3}s; --delay:-${(index * 1.37).toFixed(1)}s`,
}));
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Giggles & Shitz Halloween Party — RSVP if you dare." />
    <link rel="icon" href="./favicon.svg" type="image/svg+xml" />
    <title>Giggles & Shitz — Halloween Party</title>
  </head>
  <body>
    <div class="grain"></div>
    <div class="moon" aria-hidden="true"></div>
    <div class="bat-swarm" aria-hidden="true">
      {bats.map((bat) => <span class="bat" style={bat.style}>🦇</span>)}
    </div>

    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label="Giggles and Shitz home">GAS</a>
      <nav aria-label="Main navigation">
        <a href="#details">The plan</a>
        <a href="#costumes">Costumes</a>
        <a class="nav-rsvp" href="#rsvp">RSVP</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero wrap">
        <div class="hero-copy">
          <p class="eyebrow">GAS presents</p>
          <h1>Fright<br /><em>Night.</em></h1>
          <p class="hero-text">A Halloween party for good costumes, pizza, drinks, and the people you actually want to see.</p>
          <a class="button button-orange" href="#rsvp">RSVP <span>→</span></a>
        </div>
        <div class="poster">
          <div class="poster-stars">✦ &nbsp; ✧ &nbsp; ✦</div>
          <img src="./giggles-shitz-wordmark.svg" alt="Giggles and Shitz" />
          <p>HALLOWEEN · WAREEMBA</p>
          <div class="poster-date"><b>31</b><span>OCT<br />FRI</span></div>
          <div class="poster-splat">COSTUMES<br />ARE<br />COMPULSORY</div>
        </div>
      </section>

      <section id="details" class="event-details wrap section">
        <p class="eyebrow">Mark your haunted calendar</p>
        <div class="details-grid">
          <article><span class="detail-icon">◒</span><h2>When</h2><p><b>Saturday, 31 October</b><br />Starts at 8:00pm</p></article>
          <article><span class="detail-icon">⌂</span><h2>Where</h2><p><b>Wareemba</b><br />Full address sent after RSVP</p></article>
          <article><span class="detail-icon">✦</span><h2>Dress code</h2><p><b>Costumes compulsory</b><br />Bring up to two friends</p></article>
          <article><span class="detail-icon">◈</span><h2>Drinks</h2><p><b>BYO</b><br />Bring whatever you like to drink</p></article>
        </div>
      </section>

      <section id="costumes" class="costumes section">
        <div class="wrap">
          <div class="section-heading"><div><p class="eyebrow">Costumes compulsory</p><h2>Costume <em>notes</em></h2></div><p>Keep it polished, strange or specific. The assignment is open.</p></div>
          <div class="inspo-grid">
            <article class="inspo ghost"><span>01</span><h3>Dead<br />prom queen</h3><p>Pretty, ruined, perfect.</p></article>
            <article class="inspo witch"><span>02</span><h3>Inanimate<br />object</h3><p>Commit to the bit.</p></article>
            <article class="inspo alien"><span>03</span><h3>2025–26<br />controversy</h3><p>Keep it clever.</p></article>
            <article class="inspo clown"><span>04</span><h3>Vampire<br />after dark</h3><p>Black tailoring, one good detail.</p></article>
            <article class="inspo fifth"><span>05</span><h3>Last-minute<br />icon</h3><p>Simple can still be sharp.</p></article>
            <article class="inspo sixth"><span>06</span><h3>Something<br />uncanny</h3><p>Recognisable from across the room.</p></article>
          </div>
        </div>
      </section>

      <section class="pizza-section wrap section" id="pizza">
        <div class="pizza-title"><p class="eyebrow">Important business</p><h2>Pizza <em>order</em></h2><p>Let us know what you want so we can order properly.</p></div>
        <form class="pizza-form form-card" data-form="pizza">
          <fieldset>
            <legend>What should we order?</legend>
            <label><input type="checkbox" name="pizza" value="Pepperoni" /> <span>🍕</span> Pepperoni</label>
            <label><input type="checkbox" name="pizza" value="Margherita" /> <span>🍅</span> Margherita</label>
            <label><input type="checkbox" name="pizza" value="Veggie" /> <span>🥦</span> Veggie</label>
            <label><input type="checkbox" name="pizza" value="Hawaiian" /> <span>🍍</span> Hawaiian (brave)</label>
          </fieldset>
          <label class="field-label">Any allergies / dietary things?<input name="dietary" placeholder="e.g. gluten-free, no dairy, no anchovies please..." /></label>
          <button class="button button-lime" type="submit">Submit pizza choice <span>↗</span></button>
          <p class="form-message" aria-live="polite"></p>
        </form>
      </section>

      <section id="rsvp" class="rsvp section">
        <div class="wrap rsvp-grid">
          <div><p class="eyebrow">Saturday 31 October</p><h2>RSVP<br /><em>here.</em></h2><p class="rsvp-note">Please reply by <b>24 October</b>.</p><div class="pumpkin">🎃</div></div>
          <form class="rsvp-form form-card" data-form="rsvp">
            <label class="field-label">Name<input required name="name" autocomplete="name" placeholder="Your name" /></label>
            <label class="field-label">Email<input required type="email" name="email" autocomplete="email" placeholder="you@email.com" /></label>
            <fieldset class="attendance"><legend>Can you make it?</legend><label><input required type="radio" name="attending" value="Yes" /> Yes</label><label><input type="radio" name="attending" value="No" /> No</label></fieldset>
            <label class="field-label">Friends coming with you?<select name="guests"><option value="0">Just me</option><option value="1">+1 friend</option><option value="2">+2 friends</option></select></label>
            <label class="field-label">Costume (optional)<input name="costume" placeholder="If you know already" /></label>
            <button class="button button-orange" type="submit">Send RSVP <span>→</span></button>
            <p class="form-message" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>
    <footer><img src="./giggles-shitz-wordmark.svg" alt="Giggles and Shitz" /><p>Halloween in Wareemba · BYO · Costumes compulsory</p></footer>
    <script>
      document.querySelectorAll('form[data-form]').forEach((form) => {
        form.addEventListener('submit', (event) => {
          event.preventDefault();
          const message = form.querySelector('.form-message');
          const type = form.dataset.form;
          if (message) message.textContent = type === 'rsvp' ? 'You’re on the list. See you there.' : 'Pizza choice received.';
          form.reset();
        });
      });
    </script>
  </body>
</html>
